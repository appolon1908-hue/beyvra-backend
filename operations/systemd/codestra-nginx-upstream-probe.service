[Unit]
Description=Beyvra staging Nginx upstream availability probe
After=docker.service network-online.target
Wants=docker.service network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/github-projects/backend
ExecStart=/root/github-projects/backend/operations/check_nginx_upstreams.sh
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
