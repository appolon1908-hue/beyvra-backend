SECRET_KEY="replace-with-a-random-secret"
# DEBUG can be 0 or 1 (1 Means true)
DEBUG = 0
ALLOWED_HOSTS =["127.0.0.1", "localhost", "0.0.0.0", "beyvra.com", "www.beyvra.com", "api.beyvra.com", "admin.beyvra.com", "platform.beyvra.com", "staging.beyvra.com"]
CSRF_TRUSTED_ORIGINS ='["http://localhost:8000", "http://127.0.0.1:8000", "https://beyvra.com", "https://www.beyvra.com", "https://api.beyvra.com", "https://admin.beyvra.com", "https://platform.beyvra.com", "https://staging.beyvra.com"]'

# Docker Settings
COMPOSE_PROJECT_NAME=fx_portal_backend
COMPOSE_FILE=docker-compose-dev.yaml
COMPOSE_HTTP_TIMEOUT=86400
PORT=8000

# BACKEND CONFIG
PROJECT_NAME=trading
API_ENVIRONMENT=development
NUM_PROXIES=0
CORS_ALLOW_ALL_ORIGINS=false
CORS_ALLOWED_ORIGINS=["https://beyvra.com","https://www.beyvra.com","https://platform.beyvra.com","https://staging.beyvra.com"]
CORS_ALLOW_CREDENTIALS=true
LOG_LEVEL=INFO
BACKEND_PORT=
BACKEND_HOST=
# 1 or 0, where 0 = False and 1 = True
RATE_LIMIT=1
PAPER_TRADING_ONLY=true
TRADING_MODE=paper

# LOGGING
ADMINS="username,username@example.com"
STATSD_HOST="statsd-exporter:9125"
STATSD_PREFIX="fx"

# Database settings
DB_NAME='fxportal'
DB_USER='postgres'
DB_PASSWORD='replace-me'
DB_HOST='localhost'
DB_PORT='5432'
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14

# REDIS CONFIG
REDIS_PASSWORD=replace-me
REDIS_PORT=6379
REDIS_POOL_MAX_CONNECTIONS=10
REDIS_DATABASE=0
REDIS_HOST=redis

# Staging realtime V2 (keep disabled in production; provision secrets outside git)
REALTIME_V2_ENABLED=false
REALTIME_V2_STAGING_ENABLED=false
REALTIME_V2_V1_FALLBACK_ENABLED=true
CENTRIFUGO_ENABLED=false
NATS_JETSTREAM_ENABLED=false
PRODUCTION_REALTIME_V2_ENABLED=false
REAL_MONEY_ENABLED=false
FINANCIAL_SERVICE_OVERALL_DEADLINE_SECONDS=12
POLYGON_OMS_ENABLED=false
POLYGON_OMS_PRODUCTION_ENABLED=false
POLYGON_OMS_HALTED=true
CROSS_CHAIN_TRANSFERS_ENABLED=false
ALL_FINANCIAL_MUTATIONS_HALTED=true
LIVE_TRADING_ENABLED=false
PAYMENTS_ENABLED=false
CENTRIFUGO_TOKEN_HMAC_SECRET=
CENTRIFUGO_API_KEY=
CENTRIFUGO_ADMIN_PASSWORD=
CENTRIFUGO_PROXY_SECRET=
NATS_URL=nats://nats:4222
REDIS_EXPIRE_KEY=3600


# SERVER CONFIG gunicorn_conf.py
# https://docs.gunicorn.org/en/stable/settings.html#settings
GUNICORN_KEEP_ALIVE=5
GUNICORN_TIMEOUT=60
GUNICORN_GRACEFUL_TIMEOUT=60
GUNICORN_ACCESS_LOG="-"
GUNICORN_ERROR_LOG="-"
GUNICORN_WORKERS_PER_CORE=1
GUNICORN_MAX_WORKERS=100
GUNICORN_MAX_REQUESTS=10
# GUNICORN_WEB_CONCURRENCY=3

# EMAIL CONFIG
EMAIL_HOST=""
EMAIL_PORT=
EMAIL_HOST_USER=""
EMAIL_HOST_PASSWORD=""

# IDENTITY: activate only after the Keycloak client and same-origin /api proxy
# are runtime-verified. Keycloak is then the only password/recovery authority.
KEYCLOAK_IDENTITY_ENABLED=false
LOCAL_PASSWORD_AUTH_ENABLED=true
EMAIL_REGISTRATION_ENABLED=true
KEYCLOAK_ISSUER="https://auth.codestra.co/realms/codestra"
KEYCLOAK_CLIENT_ID="beyvra-web-production"
KEYCLOAK_REDIRECT_URI="https://beyvra.com/api/v1/auth/oidc/callback/"
KEYCLOAK_FRONTEND_CALLBACK="https://beyvra.com/auth/callback"
KEYCLOAK_POST_LOGOUT_URI="https://beyvra.com/signIn?logged_out=1"
KEYCLOAK_TRANSACTION_TTL_SECONDS=300
KEYCLOAK_SESSION_HINT_TTL_SECONDS=604800

# CLIENT
PUBLIC_BRAND_NAME="Beyvra"
PUBLIC_SITE_URL="https://beyvra.com"
PUBLIC_API_URL="https://api.beyvra.com"
PUBLIC_WS_URL="wss://api.beyvra.com/ws/v2/"
PUBLIC_STATUS_URL="https://api.beyvra.com/health/ready"
TRANSACTIONAL_EMAIL_ENABLED=false
BEYVRA_EMAIL_API_URL="https://api.codestra.co"
BEYVRA_EMAIL_TOKEN_URL="https://auth.codestra.co/realms/codestra/protocol/openid-connect/token"
BEYVRA_EMAIL_CLIENT_SECRET_FILE="/run/secrets/beyvra_email_client_secret"
FRONTEND_URL="https://beyvra.com"
GOOGLE_OIDC_REDIRECT_URI="https://api.beyvra.com/api/v1/auth/google/callback"
# Empty values keep cookies host-only. Do not share application/admin sessions
# across unrelated subdomains.
SESSION_COOKIE_DOMAIN=
CSRF_COOKIE_DOMAIN=

# CELERY
FLOWER_USERNAME=""
FLOWER_PASSWORD=""

# SMS
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_SEND_FROM_NUMBER=""

# ALPACA
API_KEY_ALPACA=
API_SECRET_ALPACA=
ALPACA_TRADING_BASE_URL=https://paper-api.alpaca.markets
ALPACA_BROKER_BASE_URL=https://broker-api.sandbox.alpaca.markets
ALPACA_DATA_BASE_URL=https://data.alpaca.markets

# NEWS
NEWS_DATA_API_KEY=
NEWS_DATA_API_KEY_FILE=
POLYGON_API_KEY=
POLYGON_API_KEY_FILE=
TWELVE_DATA_API_KEY=
PROVIDER_CREDENTIAL_ROOT=/etc/codestra/providers
COINGECKO_API_KEY=
COINGECKO_API_KEY_FILE=
SCHEMA_API_KEY=
TWELVE_DATA_REST_URL=https://api.twelvedata.com/time_series
TWELVE_DATA_WEBSOCKET_URL=wss://ws.twelvedata.com/v1/quotes/price
FIXER_API_KEY=
CORS_ALLOW_ALL_ORIGINS=false
CORS_ALLOW_CREDENTIALS=false
CORS_ALLOWED_ORIGINS=["https://beyvra.com", "https://www.beyvra.com", "https://staging.beyvra.com"]
RATE_LIMIT=true
ANON_RATE_LIMIT=30/minute
USER_RATE_LIMIT=300/minute
NOTIFICATION_RETENTION_DAYS=90
WEBHOOK_TIMEOUT_SECONDS=10

# COINMARKETCAP
COINMARKETCAP_API_KEY=
COINMARKETCAP_URL=
# Protected secret files (mounted read-only at runtime; never commit their contents)
DATA_ENCRYPTION_KEY_FILE=/run/secrets/codestra/data-encryption.key
API_TOKEN_PEPPER_FILE=/run/secrets/codestra/api-token-pepper.key
WEBHOOK_MASTER_KEY_FILE=/run/secrets/codestra/webhook-master.key
STAGING_WEBHOOK_RECEIVER_SECRET_FILE=/run/secrets/codestra/staging-webhook-receiver.key
PASSWORD_RESET_SIGNING_KEY_FILE=/run/secrets/codestra/password-reset-signing.key
