DEPLOYMENT_ENV=staging

# Internal service addresses used by observability components.
BEYVRA_BACKEND_METRICS_TARGET=beyvra-backend:8000
BEYVRA_BACKEND_EXPORTER_TARGET=beyvra-backend:7001
BEYVRA_FRONTEND_URL=https://beyvra.com
BEYVRA_API_HEALTH_URL=https://api.beyvra.com/health
BEYVRA_API_READY_URL=https://api.beyvra.com/ready
POSTGRES_EXPORTER_TARGET=postgres-exporter:9187

# Grafana datasource URLs.
PROMETHEUS_URL=http://prometheus:9090
LOKI_URL=http://loki:3100
TEMPO_URL=http://tempo:3200

# Alloy/collector endpoints.
LOKI_PUSH_URL=http://loki:3100/loki/api/v1/push
OTLP_GRPC_ENDPOINT=http://tempo:4317

# OpenBao runtime endpoint. Tokens and AppRole secrets belong in secret storage only.
OPENBAO_ADDR=https://bao.codestra.media
