logging {
  level  = "info"
  format = "json"
}

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "beyvra_containers" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    regex         = "beyvra-backend|beyvra-frontend|beyvra-worker|redis|postgres|centrifugo|nats"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }

  rule {
    target_label = "environment"
    replacement  = "production"
  }
}

loki.source.docker "beyvra_logs" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.beyvra_containers.output
  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

prometheus.scrape "beyvra_backend" {
  targets = [
    {"__address__" = "beyvra-backend:8000", "service" = "beyvra-backend", "component" = "django", "environment" = "production"},
    {"__address__" = "beyvra-backend:7001", "service" = "beyvra-backend", "component" = "prometheus-exporter", "environment" = "production"},
  ]
  metrics_path = "/metrics"
  forward_to   = [prometheus.remote_write.default.receiver]
}

prometheus.remote_write "default" {
  endpoint {
    url = "http://prometheus:9090/api/v1/write"
  }
}

otelcol.receiver.otlp "default" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }

  http {
    endpoint = "0.0.0.0:4318"
  }

  output {
    traces = [otelcol.exporter.otlp.tempo.input]
  }
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"
    tls {
      insecure = true
    }
  }
}
