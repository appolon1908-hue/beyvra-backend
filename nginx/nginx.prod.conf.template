resolver 127.0.0.11 valid=10s ipv6=off;

upstream web {
    zone web 64k;
    server ${WEB_HOST} resolve;
}

upstream daphne {
    zone daphne 64k;
    server ${DAPHNE_HOST} resolve;
}

upstream centrifugo {
    zone centrifugo 64k;
    server ${CENTRIFUGO_HOST} resolve;
}

server {
    listen 8080;
    server_name ${PUBLIC_SERVER_NAME};
    client_max_body_size 25M;
    proxy_read_timeout 60;
    proxy_connect_timeout 10;
    proxy_send_timeout 60;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'" always;
    default_type application/json;

    # This edge is deliberately read-only. Authentication callbacks and
    # WebSocket upgrades use safe methods; every state-changing HTTP request
    # is rejected before it reaches Django.
    if ($request_method !~ ^(GET|HEAD|OPTIONS)$) {
        return 503 '{"error":{"code":"DEPLOYMENT_READ_ONLY","detail":"State-changing requests are disabled for this candidate."}}';
    }

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location = /metrics { return 404; }
    location ^~ /metrics/ { return 404; }
    location ^~ /prometheus/ { return 404; }
    location ^~ /grafana/ { return 404; }

    location / {
        proxy_pass http://web;
        proxy_set_header X-Request-ID $request_id;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Host $host;
        proxy_redirect off;
    }

    location /ws/ {
        proxy_pass http://daphne;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header X-Request-ID $request_id;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect off;
    }

    location /ws/v2/ {
        proxy_pass http://centrifugo/connection/websocket;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header X-Request-ID $request_id;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60;
    }

    location /static/ {
        alias /app/static/;
    }

    location /media/ {
        alias /app/media/;
        add_header X-Content-Type-Options "nosniff" always;
    }
}
