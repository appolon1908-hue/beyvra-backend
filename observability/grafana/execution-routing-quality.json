{"title":"Beyvra / Execution Routing & Quality","uid":"beyvra-execution-routing-quality","schemaVersion":39,"version":1,"refresh":"30s","panels":[{"type":"timeseries","title":"Routes by provider","targets":[{"expr":"sum by (provider) (rate(beyvra_execution_route_selected_total[5m]))"}]},{"type":"timeseries","title":"Routing rejection reasons","targets":[{"expr":"sum by (provider,result) (rate(beyvra_execution_route_rejections_total[5m]))"}]},{"type":"stat","title":"Provider health / circuit","targets":[{"expr":"beyvra_execution_circuit_breaker_state"}]},{"type":"timeseries","title":"Provider latency","targets":[{"expr":"histogram_quantile(0.95,sum by (le,provider)(rate(beyvra_execution_provider_latency_seconds_bucket[5m])))"}]},{"type":"timeseries","title":"Average slippage","targets":[{"expr":"sum(rate(beyvra_execution_quality_slippage_bps_sum[5m]))/sum(rate(beyvra_execution_quality_slippage_bps_count[5m]))"}]},{"type":"timeseries","title":"Price improvement","targets":[{"expr":"sum(rate(beyvra_execution_price_improvement_bps_sum[5m]))/sum(rate(beyvra_execution_price_improvement_bps_count[5m]))"}]},{"type":"stat","title":"Unknown outcomes","targets":[{"expr":"sum(increase(beyvra_execution_unknown_outcomes_total[1h]))"}]},{"type":"stat","title":"Reconciliation violations","targets":[{"expr":"sum(increase(beyvra_execution_reconciliation_violations_total[1h]))"}]}]}
