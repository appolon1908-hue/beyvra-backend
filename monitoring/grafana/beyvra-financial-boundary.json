{
  "title": "Beyvra / Financial Boundary",
  "tags": ["beyvra", "financial-boundary", "no-pii"],
  "schemaVersion": 39,
  "panels": [
    {"type":"stat","title":"Financial Service health","targets":[{"expr":"beyvra_financial_service_health"}]},
    {"type":"timeseries","title":"Request and failure rate","targets":[{"expr":"sum(rate(beyvra_financial_client_requests_total[5m]))"},{"expr":"sum(rate(beyvra_financial_client_failures_total[5m]))"}]},
    {"type":"timeseries","title":"Latency","targets":[{"expr":"histogram_quantile(0.95, sum by (le) (rate(beyvra_financial_client_duration_seconds_bucket[5m])))"}]},
    {"type":"stat","title":"Circuit breaker","targets":[{"expr":"beyvra_financial_circuit_breaker_state"}]},
    {"type":"timeseries","title":"Idempotency conflicts and unknown outcomes","targets":[{"expr":"sum(rate(beyvra_financial_idempotency_conflicts_total[5m]))"},{"expr":"sum(rate(beyvra_financial_unknown_outcomes_total[5m]))"}]},
    {"type":"timeseries","title":"Reconciliation violations","targets":[{"expr":"sum(rate(beyvra_financial_reconciliation_violations_total[5m]))"}]},
    {"type":"timeseries","title":"Withdrawal security denials","targets":[{"expr":"sum(rate(beyvra_withdrawal_security_denials_total[5m]))"},{"expr":"sum(rate(beyvra_withdrawal_step_up_required_total[5m]))"}]}
  ]
}
